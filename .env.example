# ClipStack Environment Variables
# Copy to .env.local and fill in values

# Whop App
NEXT_PUBLIC_WHOP_APP_ID=app_HT52ox6luoJcv

# Whop API (from Developer Dashboard → Keys)
WHOP_API_KEY=

# Whop Webhook (from webhook creation)
WHOP_WEBHOOK_SECRET=

# Whop OAuth
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=

# App Config
NEXT_PUBLIC_APP_URL=https://clipstack-black.vercel.app
NEXT_PUBLIC_APP_NAME=ClipStack
WHOP_REDIRECT_URI=

# Node
NODE_ENV=development
